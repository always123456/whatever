# 复制为 .env 后按需修改（本机无需 .env 也能跑，默认值见 app/config.py）

# 数据库：默认 SQLite（免部署）；生产可换成 PostgreSQL
# JM_DATABASE_URL=postgresql+psycopg://user:pass@127.0.0.1:5432/job_match
JM_DATABASE_URL=sqlite:///./job_match.db
JM_SECRET_KEY=dev-secret-change-me
JM_DEBUG=false
JM_TOP_N=10

# 匹配文本相似度后端：keyword(默认，零依赖确定性) | semantic(需装 sentence-transformers + bge 模型)
JM_EMBEDDING_BACKEND=keyword
JM_SEMANTIC_MODEL=BAAI/bge-small-zh-v1.5
